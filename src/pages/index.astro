---
import LinkIcon from '../components/LinkIcon.astro';

const links = [
	{
		name: 'X (Twitter)',
		handle: '@yuuturn5',
		url: 'https://x.com/yuuturn5',
		icon: 'x',
	},
	{
		name: 'Bluesky',
		handle: 'yuuturn5.yfujii.net',
		url: 'https://bsky.app/profile/yuuturn5.yfujii.net',
		icon: 'bluesky',
	},
	{
		name: 'GitHub',
		handle: 'yuuturn',
		url: 'https://github.com/yuuturn',
		icon: 'github',
	},
	{
		name: 'Blog',
		handle: 'はてなブログ',
		url: 'https://yuuturn0422.hatenablog.jp/',
		icon: 'blog',
	},
] as const;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="yuuturn5 のプロフィールページ。SNS・GitHub・ブログへのリンク集。" />
		<meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#131317" media="(prefers-color-scheme: dark)" />
		<title>yuuturn5 profile</title>
	</head>
	<body>
		<main>
			<header>
				<h1>Welcome to yuuturn5's profile page</h1>
			</header>
			<section class="about" aria-label="自己紹介">
				<p>I'm a Server and Network Engineer.</p>
				<p>いんたーねっとのなにかをしてる人。ゆとり世代。</p>
				<p>最近はネットワークエンジニアしている。趣味でDNSとかEmailあたりの技術、BGPは入門中。</p>
				<p>猫が好き。音楽、クラブ、カメラ、アニメも好き。</p>
			</section>
			<p class="more-label">More info</p>
			<nav aria-label="プロフィールリンク">
				<ul>
					{
						links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									<span class="icon" aria-hidden="true">
										<LinkIcon icon={link.icon} />
									</span>
									<span class="text">
										<span class="name">{link.name}</span>
										<span class="handle">{link.handle}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: #f7f7f8;
		--fg: #1a1a1e;
		--muted: #6b6b74;
		--card-bg: #ffffff;
		--card-border: #e4e4e9;
		--accent: #2563eb;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #131317;
			--fg: #ececf1;
			--muted: #9b9ba4;
			--card-bg: #1c1c22;
			--card-border: #2c2c34;
			--accent: #60a5fa;
		}
	}

	html {
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	body {
		margin: 0;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		background: var(--bg);
		color: var(--fg);
		font-family:
			system-ui,
			-apple-system,
			'Hiragino Kaku Gothic ProN',
			'Noto Sans JP',
			sans-serif;
	}

	main {
		/* viewport 幅に追従しつつ、大きい画面では読みやすい幅で止める */
		width: min(100%, 30rem);
		/* 縦横とも auto マージンで中央寄せ(内容が画面より高くても上端が切れない) */
		margin: auto;
		/* padding 分が幅に加算されて横スクロールが出ないようにする */
		box-sizing: border-box;
		padding: clamp(2rem, 8vw, 3rem) clamp(1rem, 5vw, 1.5rem);
		text-align: center;
		--icon-size: clamp(1.4rem, 6vw, 1.6rem);
	}

	h1 {
		margin: 0 0 clamp(1.5rem, 6vw, 2rem);
		font-size: clamp(1.6rem, 7vw, 2rem);
		line-height: 1.35;
		letter-spacing: 0.01em;
		text-wrap: balance;
	}

	.more-label {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}

	.about {
		margin: 0 0 clamp(1.75rem, 7vw, 2.25rem);
		padding: clamp(1.1rem, 4.6vw, 1.5rem);
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 0.85rem;
		text-align: left;
	}

	.about p {
		margin: 0.35rem 0;
		font-size: clamp(1rem, 4vw, 1.05rem);
		line-height: 1.8;
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	nav a {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 3.5vw, 1rem);
		min-height: 4.25rem;
		padding: clamp(0.85rem, 3.8vw, 1.05rem) clamp(0.9rem, 4vw, 1.25rem);
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 0.85rem;
		text-decoration: none;
		color: inherit;
		text-align: left;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	nav a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.icon {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--icon-size);
		height: var(--icon-size);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.name {
		font-size: clamp(1.05rem, 4.4vw, 1.1rem);
		font-weight: 600;
	}

	.handle {
		font-size: clamp(0.9rem, 3.8vw, 0.95rem);
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	/* タッチ端末では hover の浮き上がりを無効化(タップ後に残るため) */
	@media (hover: hover) and (pointer: fine) {
		nav a:hover {
			border-color: var(--accent);
			transform: translateY(-2px);
		}

		nav a:hover .icon {
			color: var(--accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav a {
			transition: none;
		}
	}
</style>
