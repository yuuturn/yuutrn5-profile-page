---
const links = [
	{
		name: 'X (Twitter)',
		handle: '@yuuturn5',
		url: 'https://x.com/yuuturn5',
	},
	{
		name: 'Bluesky',
		handle: 'yuuturn5.yfujii.net',
		url: 'https://bsky.app/profile/yuuturn5.yfujii.net',
	},
	{
		name: 'GitHub',
		handle: 'yuuturn',
		url: 'https://github.com/yuuturn',
	},
	{
		name: 'Blog',
		handle: 'はてなブログ',
		url: 'https://yuuturn0422.hatenablog.jp/',
	},
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="yuuturn5 のプロフィールページ。SNS・GitHub・ブログへのリンク集。" />
		<title>yuuturn5 profile</title>
	</head>
	<body>
		<main>
			<header>
				<h1>Welcome to yuuturn5's profile page</h1>
			</header>
			<section class="about" aria-label="自己紹介">
				<p>I'm a Server and Network Engineer.</p>
				<p>いんたーねっとのなにかをしてる人。ゆとり世代。</p>
				<p>最近はネットワークエンジニアしている。趣味でDNSとかEmailあたりの技術、BGPは入門中。</p>
				<p>猫が好き。音楽、クラブ、カメラ、アニメも好き。</p>
			</section>
			<p class="more-label">More info</p>
			<nav aria-label="プロフィールリンク">
				<ul>
					{
						links.map((link) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer">
									<span class="name">{link.name}</span>
									<span class="handle">{link.handle}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--bg: #f7f7f8;
		--fg: #1a1a1e;
		--muted: #6b6b74;
		--card-bg: #ffffff;
		--card-border: #e4e4e9;
		--accent: #2563eb;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #131317;
			--fg: #ececf1;
			--muted: #9b9ba4;
			--card-bg: #1c1c22;
			--card-border: #2c2c34;
			--accent: #60a5fa;
		}
	}

	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg);
		color: var(--fg);
		font-family:
			system-ui,
			-apple-system,
			'Hiragino Kaku Gothic ProN',
			'Noto Sans JP',
			sans-serif;
	}

	main {
		width: min(100%, 26rem);
		padding: 3rem 1.25rem;
		text-align: center;
		box-sizing: border-box;
	}

	h1 {
		margin: 0 0 2rem;
		font-size: 1.6rem;
		line-height: 1.4;
		letter-spacing: 0.01em;
	}

	.more-label {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}

	.about {
		margin: 0 0 2rem;
		padding: 1.25rem 1.5rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 0.75rem;
		text-align: left;
	}

	.about p {
		margin: 0.25rem 0;
		font-size: 0.925rem;
		line-height: 1.8;
	}

	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	nav a {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 1rem 1.25rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 0.75rem;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	nav a:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.name {
		font-weight: 600;
	}

	.handle {
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
